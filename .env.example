# ============================================================
#  Environment template — copy this file to ".env" and fill in.
#    cp .env.example .env
#
#  NOTE: None of these are used YET. The app currently runs on a
#  local SQLite database with no accounts. These variables become
#  active when we switch the backend to Supabase (cloud).
#
#  ".env" is git-ignored (never committed). This ".example" file
#  is committed as a blank template only — put NO real values here.
# ============================================================

# ── Supabase (future cloud backend) ─────────────────────────
# Where to find these: Supabase Dashboard
#   → your project → Settings → API
#
# The electron-vite "MAIN_VITE_" prefix exposes the value to the
# app's main process only (where the database code lives), keeping
# keys out of the visible UI layer.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
MAIN_VITE_SUPABASE_URL=

# Publishable "anon" (public) key — safe to ship inside the app.
MAIN_VITE_SUPABASE_ANON_KEY=

# ── Do NOT put the service_role / secret key here ───────────
# The service_role key bypasses all security rules. It must never
# be committed or shipped in the desktop app. It is only ever used
# on a trusted server, never in .env.example.
