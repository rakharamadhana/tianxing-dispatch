{
  "name": "tianxing-dispatch",
  "version": "0.1.2",
  "description": "Tianxing Moving Co. dispatch table (出車表) — cross-platform desktop app",
  "main": "out/main/index.js",
  "author": "Tianxing Moving Co.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win nsis",
    "build:mac": "electron-vite build && electron-builder --mac dmg",
    "build:unpack": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  }
}
